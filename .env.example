# Публичный адрес сайта. Используется для canonical, Open Graph, sitemap, Schema.org
# и для абсолютных ссылок hreflang/x-default (@nuxtjs/i18n читает эту же переменную на сборке).
# Локальная разработка: http://localhost:3000
# Vercel Preview: адрес preview-деплоя (https://...)
# Vercel Production: окончательный публичный HTTPS-домен проекта.
# Production-сборку нельзя выпускать с localhost в canonical, sitemap или Open Graph.
NUXT_SITE_URL=http://localhost:3000

# Имя сайта в Open Graph и Schema.org.
NUXT_SITE_NAME=GLUKE

# Окружение сайта. Управляет индексацией в robots.txt.
# Локальная разработка: development (индексация запрещена)
# Vercel Preview: staging (индексация запрещена)
# Vercel Production: production (индексация разрешена)
NUXT_SITE_ENV=development
